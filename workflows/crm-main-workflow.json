{
  "name": "Project 01 - AI Lead Qualification CRM",
  "nodes": [
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item, index) => {\n  const lead = item.json.body || item.json;\n  const errors = [];\n\n  const event_id = String(lead.event_id ?? \"\").trim();\n\n  if (!/^[A-Za-z0-9_-]{6,100}$/.test(event_id)) {\n    errors.push(\"A valid event_id is required\");\n  }\n\n  const name = String(lead.name ?? \"\").trim();\n  const email = String(lead.email ?? \"\").trim().toLowerCase();\n  const phone = String(lead.phone ?? \"\").trim();\n  const company = String(lead.company ?? \"\").trim();\n  const service = String(lead.service ?? \"\").trim();\n  const timeline = String(lead.timeline ?? \"\").trim();\n  const message = String(lead.message ?? \"\").trim();\n  const source = String(lead.source ?? \"unknown\").trim();\n\n  const rawBudget = lead.budget;\n  const budget = rawBudget === \"\" || rawBudget == null\n    ? null\n    : Number(rawBudget);\n\n  if (name.length < 2) {\n    errors.push(\"Name must contain at least 2 characters\");\n  }\n\n  const emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  if (!emailPattern.test(email)) {\n    errors.push(\"Invalid email address\");\n  }\n\n  if (budget !== null &&\n      (!Number.isFinite(budget) || budget < 0)) {\n    errors.push(\"Budget must be a non-negative number\");\n  }\n\n  if (!service) {\n    errors.push(\"Service is required\");\n  }\n\n  return {\n    json: {\n      lead_id: String(lead.lead_id ?? \"\").trim(),\n      event_id,\n      name,\n      email,\n      phone,\n      company,\n      service,\n      budget,\n      timeline,\n      message,\n      source,\n      validation: {\n        is_valid: errors.length === 0,\n        errors\n      }\n    },\n    pairedItem: { item: index }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        -272
      ],
      "id": "cb05d508-8367-4ed6-a44c-3424262e96d3",
