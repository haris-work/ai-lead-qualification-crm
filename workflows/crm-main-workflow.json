    {
      "parameters": {
        "jsCode": "\nconst row = $input.first().json;\n\nconst lead = $(\"ValidateAndNormalizeLead\")\n  .first().json;\n\nlet action = \"process\";\n\nif (row.event_id === lead.event_id) {\n  if (row.status === \"completed\") {\n    action = \"duplicate\";\n  } else if (row.status === \"processing\") {\n    action = \"in_progress\";\n  } else if (row.status === \"failed\") {\n    action = \"retry\";\n  }\n}\n\nreturn [{\n  json: {\n    ...lead,\n    event_action: action,\n    previous_attempts: Number(row.attempts ?? 0),\n    previous_hubspot_id: row.hubspot_id ?? null\n  }\n}];\n"
      },
